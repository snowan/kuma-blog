---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import SeriesNav from "../components/SeriesNav.astro";
import TableOfContents from "../components/TableOfContents.astro";

type ArticleEntry =
  | CollectionEntry<"writing">
  | CollectionEntry<"labNotes">
  | CollectionEntry<"visuals">;

interface Props {
  entry: ArticleEntry;
  section: "Writing" | "Lab Notes" | "Visuals";
  headings?: { depth: number; slug: string; text: string }[] | undefined;
}

const { entry, section, headings = [] } = Astro.props;
const { data } = entry;
const body = "body" in entry && typeof entry.body === "string" ? entry.body : "";
const words = body.trim() ? body.trim().split(/\s+/).length : 0;
const readingMinutes = Math.max(1, Math.ceil(words / 220));
const isDraftPreview = data.status === "draft";
---

<SiteLayout
  title={data.title}
  description={data.description}
  canonicalUrl={data.canonicalUrl}
  noindex={isDraftPreview}
  presentation={data.presentation}
>
  <main id="main-content" data-pagefind-body>
    <article>
      {
        isDraftPreview && (
          <aside class="draft-preview" aria-label="Local draft preview">
            <strong>Local draft preview</strong>
            <span>Not published and excluded from production builds, search, RSS, and sitemap.</span>
          </aside>
        )
      }
      <ArticleHeader
        section={section}
        topic={data.topic}
        title={data.title}
        description={data.description}
        publishedAt={data.publishedAt}
        updatedAt={data.updatedAt}
        lastVerified={data.lastVerified}
        readingMinutes={readingMinutes}
      />
      {data.series && <SeriesNav series={data.series} />}
      <div class="article-grid">
        <TableOfContents headings={headings} />
        <div class="article-body">
          <slot />
        </div>
      </div>
    </article>
  </main>
</SiteLayout>

---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Archive" description="Legacy Kuma Blog collections preserved outside the main feed.">
  <main id="main-content" data-pagefind-body>
    <div class="reading-column">
      <p class="eyebrow">Preserved history</p>
      <h1>Archive</h1>
      <p class="lede">
        Legacy collections remain in their current repository paths until each
        migration batch and URL decision receives separate review.
      </p>
    </div>
  </main>
</SiteLayout>

---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { slugFromId } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => data.status === "published");
  return entries.map((entry) => ({ params: { slug: slugFromId(entry.id) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"writing">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} section="Writing" headings={headings}>
  <Content />
</ArticleLayout>

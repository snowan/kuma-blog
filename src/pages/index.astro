---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContentIndex from "../components/ContentIndex.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import TopicCard from "../components/TopicCard.astro";
import { legacyPostCount } from "../lib/legacy-content";
import { formatDate, slugFromId, TOPICS, withBase } from "../lib/site";

const [writing, labNotes, visuals] = await Promise.all([
  getCollection("writing", ({ data }) => data.status === "published"),
  getCollection("labNotes", ({ data }) => data.status === "published"),
  getCollection("visuals", ({ data }) => data.status === "published"),
]);
writing.sort((left, right) =>
  (right.data.publishedAt?.getTime() ?? 0) - (left.data.publishedAt?.getTime() ?? 0),
);
const featured = writing.find(({ data }) => data.featured) ?? writing[0];
const curatedCount = writing.length + labNotes.length + visuals.length;
const totalCount = curatedCount + legacyPostCount;
visuals.sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
---

<SiteLayout>
  <main id="main-content" data-pagefind-body>
    <section class="home-hero reading-column">
      <p class="eyebrow">Kuma Research Journal</p>
      <h1>Field notes on reliable AI systems</h1>
      <p class="lede">
        Research essays, implementation notes, and visual explanations about
        the systems that make model behavior useful.
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase("writing/")}>Explore writing</a>
        <a class="text-link" href={withBase("library/")}>Browse all {totalCount} posts</a>
        <a class="text-link" href={withBase("methodology/")}>How the research is verified</a>
      </div>
      <dl class="publication-summary" aria-label="Publication totals">
        <div><dt>Curated</dt><dd>{curatedCount}</dd></div>
        <div><dt>Legacy library</dt><dd>{legacyPostCount}</dd></div>
        <div><dt>All posts</dt><dd>{totalCount}</dd></div>
      </dl>
    </section>

    <section class="home-section">
      <FeaturedArticle
        eyebrow={`Featured essay · ${formatDate(featured?.data.publishedAt) ?? "Published"}`}
        title={featured?.data.title ?? "What an Agent Harness Actually Does"}
        description={featured?.data.description ?? "A system-level map of the control loop, tool boundary, durable state, and evidence that sit around a model."}
        href={featured ? withBase(`writing/${slugFromId(featured.id)}/`) : withBase("writing/")}
      >
        <SystemDiagram
          title="The harness control loop"
          steps={[
            { label: "Request", detail: "Intent and constraints" },
            { label: "Plan", detail: "Bounded next action" },
            { label: "Act", detail: "Permissioned tools" },
            { label: "Observe", detail: "Evidence and state" },
            { label: "Evaluate", detail: "Stop, recover, or continue" },
          ]}
          caption="A conceptual map for the upcoming canonical article; it does not represent live telemetry."
        />
      </FeaturedArticle>
    </section>

    <section class="home-section" aria-labelledby="visuals-heading">
      <div class="section-heading reading-column">
        <p class="eyebrow">Visual learning</p>
        <h2 id="visuals-heading">Learn through diagrams and interaction</h2>
        <ContentIndex entries={visuals.slice(0, 3)} route="visuals" emptyMessage="Reviewed visual guides will appear here." />
        <a class="text-link" href={withBase("visuals/")}>Explore all visual guides →</a>
      </div>
    </section>

    <section class="home-section" aria-labelledby="topics-heading">
      <div class="section-heading"><p class="eyebrow">Browse the systems</p><h2 id="topics-heading">Four research areas</h2></div>
      <div class="topic-grid">
        {
          TOPICS.map((topic, index) => <TopicCard {...topic} index={index} />)
        }
      </div>
    </section>

    <section class="home-section split-section" aria-labelledby="latest-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2 id="latest-heading">New from the journal</h2>
        <ContentIndex entries={writing.slice(0, 5)} route="writing" emptyMessage="No published writing yet." />
        <a class="text-link" href={withBase("library/")}>Browse the complete post directory</a>
      </div>
      <aside class="research-threads" aria-labelledby="threads-heading">
        <p class="eyebrow">Current threads</p>
        <h2 id="threads-heading">Questions in progress</h2>
        <ul>
          <li>Where should an agent harness store durable execution state?</li>
          <li>Which evals reveal recovery failures before production?</li>
          <li>How should memory systems expose freshness and provenance?</li>
        </ul>
      </aside>
    </section>
  </main>
</SiteLayout>

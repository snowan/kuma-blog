---
import SiteLayout from "../layouts/SiteLayout.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import TopicCard from "../components/TopicCard.astro";
import { TOPICS, withBase } from "../lib/site";
---

<SiteLayout>
  <main id="main-content" data-pagefind-body>
    <section class="home-hero reading-column">
      <p class="eyebrow">Kuma Research Journal</p>
      <h1>Field notes on reliable AI systems</h1>
      <p class="lede">
        Research essays, implementation notes, and visual explanations about
        the systems that make model behavior useful.
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase("writing/")}>Explore writing</a>
        <a class="text-link" href={withBase("methodology/")}>How the research is verified</a>
      </div>
    </section>

    <section class="home-section">
      <FeaturedArticle
        eyebrow="Canonical guide · arriving with the reviewed content migration"
        title="How an agent harness creates reliability"
        description="A system-level map of the control loop, tool boundary, durable state, and evidence that sit around a model."
      >
        <SystemDiagram
          title="The harness control loop"
          steps={[
            { label: "Request", detail: "Intent and constraints" },
            { label: "Plan", detail: "Bounded next action" },
            { label: "Act", detail: "Permissioned tools" },
            { label: "Observe", detail: "Evidence and state" },
            { label: "Evaluate", detail: "Stop, recover, or continue" },
          ]}
          caption="A conceptual map for the upcoming canonical article; it does not represent live telemetry."
        />
      </FeaturedArticle>
    </section>

    <section class="home-section" aria-labelledby="topics-heading">
      <div class="section-heading"><p class="eyebrow">Browse the systems</p><h2 id="topics-heading">Four research areas</h2></div>
      <div class="topic-grid">
        {
          TOPICS.map((topic, index) => <TopicCard {...topic} index={index} />)
        }
      </div>
    </section>

    <section class="home-section split-section" aria-labelledby="latest-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2 id="latest-heading">Reviewed before published</h2>
        <p>Canonical articles will appear here as the editorial migration lands. Draft repository notes remain private to the build.</p>
        <a class="text-link" href={withBase("archive/")}>Browse the publication archive</a>
      </div>
      <aside class="research-threads" aria-labelledby="threads-heading">
        <p class="eyebrow">Current threads</p>
        <h2 id="threads-heading">Questions in progress</h2>
        <ul>
          <li>Where should an agent harness store durable execution state?</li>
          <li>Which evals reveal recovery failures before production?</li>
          <li>How should memory systems expose freshness and provenance?</li>
        </ul>
      </aside>
    </section>
  </main>
</SiteLayout>

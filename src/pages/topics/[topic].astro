---
import { getCollection } from "astro:content";
import ContentIndex from "../../components/ContentIndex.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { isContentVisible, TOPICS } from "../../lib/site";

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const writing = await getCollection(
  "writing",
  ({ data }) => isContentVisible(data.status) && data.topic === topic.id,
);
const labNotes = await getCollection(
  "labNotes",
  ({ data }) => isContentVisible(data.status) && data.topic === topic.id,
);
const visuals = await getCollection(
  "visuals",
  ({ data }) => isContentVisible(data.status) && data.topic === topic.id,
);
---

<SiteLayout title={topic.label} description={topic.description}>
  <main id="main-content" data-pagefind-body>
    <div class="reading-column">
      <p class="eyebrow">Topic</p>
      <h1>{topic.label}</h1>
      <p class="lede">{topic.description}</p>
      <h2>Writing</h2>
      <ContentIndex entries={writing} route="writing" emptyMessage="No reviewed writing yet." />
      <h2>Lab Notes</h2>
      <ContentIndex entries={labNotes} route="lab-notes" emptyMessage="No reviewed lab notes yet." />
      <h2>Visuals</h2>
      <ContentIndex entries={visuals} route="visuals" emptyMessage="No reviewed visuals yet." />
    </div>
  </main>
</SiteLayout>

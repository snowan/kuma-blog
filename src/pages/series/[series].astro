---
import { getCollection } from "astro:content";
import ContentIndex from "../../components/ContentIndex.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { SERIES } from "../../lib/site";

export function getStaticPaths() {
  return SERIES.map((series) => ({ params: { series: series.id }, props: { series } }));
}

const { series } = Astro.props;
const writing = await getCollection(
  "writing",
  ({ data }) => data.status === "published" && data.series === series.id,
);
const labNotes = await getCollection(
  "labNotes",
  ({ data }) => data.status === "published" && data.series === series.id,
);
const visuals = await getCollection(
  "visuals",
  ({ data }) => data.status === "published" && data.series === series.id,
);
---

<SiteLayout title={series.label} description={`Entries in the ${series.label} series.`}>
  <main id="main-content" data-pagefind-body>
    <div class="reading-column">
      <p class="eyebrow">Series</p>
      <h1>{series.label}</h1>
      <ContentIndex entries={writing} route="writing" emptyMessage="No reviewed writing yet." />
      <ContentIndex entries={labNotes} route="lab-notes" emptyMessage="No reviewed lab notes yet." />
      <ContentIndex entries={visuals} route="visuals" emptyMessage="No reviewed visuals yet." />
    </div>
  </main>
</SiteLayout>

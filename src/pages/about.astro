---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About" description="About Kuma Blog and its focus on reliable AI systems.">
  <main id="main-content" data-pagefind-body>
    <article class="reading-column">
      <p class="eyebrow">About</p>
      <h1>An engineer's field journal</h1>
      <p class="lede">
        Kuma Blog publishes source-grounded essays, experiments, field notes,
        and visual explainers about reliable AI systems.
      </p>
      <p>
        The repository is also a working studio and historical archive. Only
        reviewed content collections are included in the generated website.
      </p>
    </article>
  </main>
</SiteLayout>

---
import type { CollectionEntry } from "astro:content";
import { formatDate, slugFromId, withBase } from "../lib/site";
import ArticleRow from "./ArticleRow.astro";

type IndexEntry =
  | CollectionEntry<"writing">
  | CollectionEntry<"labNotes">
  | CollectionEntry<"visuals">;

interface Props {
  entries: IndexEntry[];
  route: "writing" | "lab-notes" | "visuals";
  emptyMessage: string;
}

const { entries, route, emptyMessage } = Astro.props;
---

{
  entries.length > 0 ? (
    <ol class="content-list">
      {entries.map((entry) => (
        <li>
          <ArticleRow
            href={withBase(`${route}/${slugFromId(entry.id)}/`)}
            title={entry.data.title}
            description={entry.data.description}
            meta={
              entry.data.status === "draft"
                ? "Draft preview"
                : entry.data.publishedAt
                  ? formatDate(entry.data.publishedAt)
                  : undefined
            }
          />
        </li>
      ))}
    </ol>
  ) : (
    <p class="notice">{emptyMessage}</p>
  )
}
